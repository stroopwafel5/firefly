# ---- Shipped in the app (public / restricted keys) ----
# Google Maps SDK for Android key. Restrict to package net.differentroute.firefly + your signing SHA-1.
GOOGLE_MAPS_ANDROID_KEY=

# Firebase web app config (Project settings → Your apps → Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_FUNCTIONS_REGION=europe-west1
EAS_PROJECT_ID=

# ---- Server-side keys: NOT here. ----
# They live in functions/.secret.local (already filled in for Firefly) and are uploaded to
# Google Secret Manager with `npm run push-secrets`. Plain server settings: functions/.env.
# See HOW_TO_TEST.md §2.

# ---- Local development only ----
# EXPO_PUBLIC_USE_EMULATORS=1          talk to the Firebase emulators instead of production
# EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2   10.0.2.2 = your computer, seen from the Android emulator
