{
  "name": "firefly",
  "version": "1.0.0",
  "private": true,
  "description": "Firefly — Explore the world. Like a local. Kids' summer camps (Different Route), real local events and day-by-day trip plans.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "build:android": "eas build -p android --profile production",
    "build:apk": "eas build -p android --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "seed": "tsx scripts/seedFirestore.ts",
    "attractions:build": "tsx scripts/buildAttractionCache.ts",
    "set-admin": "tsx scripts/setAdmin.ts",
    "explain": "tsx scripts/explainTrip.ts",
    "check:apis": "tsx scripts/checkApis.ts",
    "test:tripadvisor": "node scripts/testTripadvisor.mjs",
    "push-secrets": "node scripts/pushSecrets.mjs",
    "firebase-config": "node scripts/setFirebaseConfig.mjs",
    "agoda-city": "tsx scripts/agodaCity.ts",
    "test:functions": "npm --prefix functions test",
    "accessibility": "tsx scripts/accessibility.ts"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/rubik": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~57.0.27",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "firebase": "^13.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-reorderable-list": "^0.18.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.14",
    "firebase-admin": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
